{
  "manifest_version": 3,
  "name": "YT → Gemini Summarizer",
  "version": "1.0.0",
  "description": "Open Gemini with a YouTube video summary prompt. Switch summary language between English, Russian, and Polish.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://youtube.com/*",
    "*://m.youtube.com/*",
    "*://youtu.be/*",
    "*://gemini.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Summarize with Gemini",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://gemini.google.com/*"],
      "js": ["content/gemini.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": ["content/youtube.js"],
      "css": ["content/youtube.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-gemini-summarizer@local",
      "strict_min_version": "121.0"
    }
  }
}
